        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/bombelli/#gravity-claim-en",
          "url": "https://nacho09021973.github.io/bombelli/#gravity-claim-en",
          "inLanguage": "en",
          "name": "Does this project solve quantum gravity or the general causal-set embedding problem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "No. It preserves and tests one historical optimization algorithm on declared inputs and ensembles. A low-energy embedding or a successful benchmark does not establish a new quantum-gravity theory, nor does optimizer failure prove that a causal set cannot be embedded.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "Project scope",
                "url": "https://github.com/nacho09021973/bombelli/blob/main/README.md"
              },
              {
                "@type": "CreativeWork",
                "name": "Full project paper",
                "url": "https://github.com/nacho09021973/bombelli/blob/main/paper/bombelli_revival_2026.md"
              }
            ]
          }
        },
        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/bombelli/#requirements-en",
          "url": "https://nacho09021973.github.io/bombelli/#requirements-en",
          "inLanguage": "en",
          "name": "Do I need a GPU or extra Python packages to run the simulation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "en",
            "text": "No GPU is required. The simulation and experiments use Python 3.12 and the standard library. From the downloaded repository, python cones.py inputs/tesis_like_12.in --dim 2 runs a demonstration; python validation_suite.py runs the smallest validation example. Development tests have separate dependencies documented in the README.",
            "citation": [
              {
