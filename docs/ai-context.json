        {
          "@type": "Question",
          "@id": "https://nacho09021973.github.io/bombelli/#what-is-causal-set-es",
          "url": "https://nacho09021973.github.io/bombelli/#what-is-causal-set-es",
          "inLanguage": "es",
          "name": "¿Qué es un conjunto causal y es lo mismo que un QCA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "inLanguage": "es",
            "text": "Un conjunto causal es un conjunto parcialmente ordenado y localmente finito: el orden representa precedencia causal. No es un autómata celular cuántico, que especifica una dinámica cuántica local en una red. Este proyecto busca coordenadas de Minkowski compatibles con un conjunto causal pequeño; no simula un QCA.",
            "citation": [
              {
                "@type": "CreativeWork",
                "name": "Original causal-set paper (1987)",
                "url": "https://doi.org/10.1103/PhysRevLett.59.521"
              },
              {
                "@type": "CreativeWork",
                "name": "QCA/QW student atlas",
                "url": "https://nacho09021973.github.io/atlas-qca-students/"
              }
            ]
